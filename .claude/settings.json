{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ensure-deps.sh",
						"timeout": 300,
						"statusMessage": "Installing dependencies..."
					}
				]
			}
		],
		"CwdChanged": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ensure-deps.sh",
						"timeout": 300,
						"statusMessage": "Installing dependencies..."
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/post-edit-check.sh"
					}
				]
			}
		]
	}
}
