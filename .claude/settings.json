{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-worktree.sh",
						"timeout": 300,
						"statusMessage": "Setting up worktree..."
					}
				]
			}
		],
		"CwdChanged": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-worktree.sh",
						"timeout": 300,
						"statusMessage": "Setting up worktree..."
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/post-edit-check.sh"
					}
				]
			}
		]
	}
}
